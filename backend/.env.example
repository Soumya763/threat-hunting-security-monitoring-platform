# Copy this file to .env and adjust if needed.
# Values match docker-compose.yml defaults.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=threat_hunting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

ELASTICSEARCH_HOST=http://localhost:9200

# Auth. JWT_SECRET_KEY is REQUIRED - the app refuses to start if it is
# left blank or set to a known-insecure placeholder. Generate a real
# value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# and paste the result below. Keep it out of version control once set.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480

# Basic login rate limiting (POST /api/v1/auth/login). In-memory and
# single-process only - it resets on restart and is not shared across
# multiple processes/instances. max_attempts failed logins from the same
# client IP within window_seconds returns 429 until the window rolls off.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Automatic detection/correlation scheduler.
ENABLE_SCHEDULER=true
DETECTION_INTERVAL_SECONDS=300

# AbuseIPDB threat-intelligence enrichment (Phase 4: IP reputation on
# Alert Details). Get a free API key at:
#   https://www.abuseipdb.com/account/api
# Leave ABUSEIPDB_API_KEY blank to disable the feature entirely - the
# rest of the platform runs normally without it; a reputation check
# simply reports "not configured" instead of calling the provider.
ABUSEIPDB_API_KEY=
ABUSEIPDB_API_URL=https://api.abuseipdb.com/api/v2/check
ABUSEIPDB_TIMEOUT_SECONDS=5
ABUSEIPDB_MAX_AGE_DAYS=90
# In-process cache TTLs, keyed by IP, to avoid repeated provider calls.
# Not shared across processes/instances (same tradeoff as the login
# rate limiter above) and cleared on restart - this is a throttle, not
# a system of record.
ABUSEIPDB_CACHE_TTL_SECONDS=1800
ABUSEIPDB_ERROR_CACHE_TTL_SECONDS=60
