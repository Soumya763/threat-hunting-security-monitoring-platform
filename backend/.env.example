# Copy this file to backend/.env and adjust. Values here are placeholders or
# local defaults that match docker-compose.yml. NEVER commit a real .env file
# or a real API key. Every provider key is optional.

# ---------- Database (PostgreSQL) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=threat_hunting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# For a managed Postgres that requires TLS, set: POSTGRES_SSLMODE=require
POSTGRES_SSLMODE=

# ---------- Search and log analytics: OpenSearch (see docs/ARCHITECTURE.md) ----------
# Local docker-compose runs the OpenSearch 2.19.7 container as service "opensearch".
# From the host use http://localhost:9200; containers use http://opensearch:9200.
# A managed OpenSearch endpoint can be used instead: put its single URL here, with
# credentials embedded, e.g. https://<user>:<password>@<host>:<port>
OPENSEARCH_HOST=http://localhost:9200
# Indices searched by Log Monitoring and local-context pivots.
OPENSEARCH_LOG_INDICES=events-*,security-events-*
PIVOT_LOOKBACK_DAYS=7

# ---------- CORS ----------
# Comma-separated exact frontend origins. Never use "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Authentication ----------
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# ---------- Detection scheduler ----------
ENABLE_SCHEDULER=true
DETECTION_INTERVAL_SECONDS=300

# ---------- File analysis ----------
# Quarantine directory (created with owner-only permissions). Relative paths are
# resolved from backend/. Never point this at a web-served folder.
QUARANTINE_DIR=quarantine
FILE_MAX_UPLOAD_BYTES=33554432
# Uploaded bytes are deleted after this many hours; the analysis report is kept.
FILE_RETENTION_HOURS=168
# Empty = bundled YARA rules in app/analysis/yara_rules.
YARA_RULES_DIR=
ANALYSIS_STEP_TIMEOUT_SECONDS=60
ANALYSIS_SUBMISSIONS_PER_MINUTE=20

# ---------- URL analysis (SSRF-hardened fetcher) ----------
URL_FETCH_TIMEOUT_SECONDS=8
URL_FETCH_TOTAL_SECONDS=20
URL_MAX_REDIRECTS=5
URL_MAX_BODY_BYTES=262144

# ---------- Threat-intelligence providers (all optional) ----------
# If a key is empty the provider reports "not configured" and the platform
# continues with local analysis. Keys are never sent to the browser.
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_CACHE_TTL_HOURS=24
# Sends the SHA-256 of an uploaded file (never the file) to providers for reputation.
PROVIDER_HASH_LOOKUP_ENABLED=true

# VirusTotal (public API is for non-commercial use; check your account terms)
# Sign up: https://www.virustotal.com/gui/join-us  (key is on your profile after sign-up)
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_API_URL=https://www.virustotal.com/api/v3
VIRUSTOTAL_MIN_INTERVAL_SECONDS=15
VIRUSTOTAL_DAILY_QUOTA=500

# MalwareBazaar (abuse.ch): free Auth-Key on every request. Sign up: https://auth.abuse.ch/
MALWAREBAZAAR_AUTH_KEY=
MALWAREBAZAAR_API_URL=https://mb-api.abuse.ch/api/v1/

# AlienVault OTX. Sign up: https://otx.alienvault.com/  (key: https://otx.alienvault.com/api)
OTX_API_KEY=
OTX_API_URL=https://otx.alienvault.com/api/v1

# urlscan.io. Visibility of submitted scans: public | unlisted | private.
# "unlisted" is the safe default; "public" scans are visible to everyone.
# Sign up: https://urlscan.io/user/signup  (key: https://urlscan.io/user/profile)
URLSCAN_API_KEY=
URLSCAN_API_URL=https://urlscan.io/api/v1
URLSCAN_VISIBILITY=unlisted

# AbuseIPDB (IP reputation for public addresses only). Sign up: https://www.abuseipdb.com/register
# Key: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
ABUSEIPDB_API_URL=https://api.abuseipdb.com/api/v2/check
ABUSEIPDB_TIMEOUT_SECONDS=5
ABUSEIPDB_MAX_AGE_DAYS=90
ABUSEIPDB_CACHE_TTL_SECONDS=1800
ABUSEIPDB_ERROR_CACHE_TTL_SECONDS=60

# RDAP bootstrap service for domain registration data (no key required)
RDAP_BASE_URL=https://rdap.org
