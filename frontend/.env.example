# API base URL the frontend calls. Vite only exposes variables prefixed
# with VITE_ to client code (via import.meta.env) - see
# src/services/api.js.
#
# Local development (default - matches the backend's local dev port):
VITE_API_BASE_URL=http://localhost:8000

# Production (set this in Vercel's project environment variables, not
# here - do not hardcode the real URL in this repo):
# VITE_API_BASE_URL=https://<render-backend-url>
